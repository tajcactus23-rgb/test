    <string name="perm_bluetooth">BLUETOOTH ACCESS</string>
    <string name="perm_bluetooth_desc">Required for BLE scanning of nearby devices. All scanning is performed locally on your device only. No data is transmitted to the internet.</string>
    <string name="perm_location">LOCATION ACCESS</string>
    <string name="perm_location_desc">Android requires location permission for BLE scanning due to platform restrictions. Location data is stored locally only and is optional for heatmap and history features. No background tracking or cloud upload.</string>
    <string name="perm_notifications">NOTIFICATION ACCESS</string>
    <string name="perm_notifications_desc">Used for detection alerts, persistent scanner notification, and background scan awareness. You can disable alerts in settings without affecting core functionality.</string>
    <string name="perm_battery">BATTERY OPTIMIZATION</string>
    <string name="perm_battery_desc">Required for long-running scans and foreground persistence. Disabling battery optimization ensures scan reliability. This is optional but recommended for field operations.</string>
    <string name="perm_shizuku">SHIZUKU MODULE</string>
    <string name="perm_shizuku_desc">Optional enhanced system integration. Enables screen-off scanning, stronger persistence, and background stability. Requires Shizuku app installed on device.</string>
    <string name="perm_root">ROOT ACCESS</string>
    <string name="perm_root_desc">Advanced operational controls available. Root access provides additional scanning capabilities and system-level integration. Use responsibly.</string>
